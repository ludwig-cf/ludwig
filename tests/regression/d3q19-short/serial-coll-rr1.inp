##############################################################################
#
#  serial-coll-rr1.inp
#
#  This test is set up to test a situation where fluid must be replaced
#  following a change in discrete shape of a colloid, but no interpolation
#  is available.
#
#  This is arranged by placing an oblate spheroid next to a wall (with
#  the minor axis perpendicular to the wall) and moving the colloid
#  away from the wall. The initial position etc are arranged so that
#  there are nine solid sites (3x3) next to the wall, all of which
#  are exposed in a single time step.
#
#  Note the initial colloid velcoity is rather large cf. the Mach number
#  constraint, and fixed. This is acceptable for a short test.
#
##############################################################################

N_cycles 2

##############################################################################
#
#  System and MPI
#
##############################################################################

size 32_32_16

##############################################################################
#
#  Fluid parameters
#
##############################################################################

isothermal_fluctuations off

##############################################################################
#
#  Free energy parameters
#
###############################################################################

free_energy none

###############################################################################
#
#  Colloid parameters
#
###############################################################################

colloid_init          input_one

colloid_one_shape     ellipsoid
colloid_one_elabc     7.5_7.5_2.5
colloid_one_euler     0.0_0.0_0.0
colloid_one_r         16.0_16.0_13.55

colloid_one_v         0.0_0.0_-0.1
colloid_one_isfixedv  1

###############################################################################
#
#  Periodic conditions / boundaries
#
###############################################################################

periodicity     1_1_0
boundary_walls  0_0_1


###############################################################################
#
#  Output frequency and type
#
###############################################################################

freq_statistics  1
config_at_end    no

###############################################################################
#
#  Miscellaneous
#
###############################################################################

random_seed 8361235
