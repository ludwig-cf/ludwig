##############################################################################
#
#  serial-chol-rr2.inp
#
#  This test is set up to test a situation where fluid must be replaced
#  following a change in discrete shape of a colloid, but no interpolation
#  is available.
#
#  This test is for liquid crystal tensor order parameter using a
#  colloid with planar anchoring (which covers all relevant code,
#  whereas normal anchoring does not). The colloid random number
#  generator must be initialised.
#
#  The colloid velocity is too large for a production simulation
#  but is required to obtain the required change in discrete
#  shape.
#
##############################################################################

N_cycles 2

##############################################################################
#
#  System and MPI
#
##############################################################################

size 32_32_16

##############################################################################
#
#  Fluid parameters
#
##############################################################################

isothermal_fluctuations off

##############################################################################
#
#  Free energy parameters
#
###############################################################################

free_energy               lc_blue_phase

fd_gradient_calculation   s7_anchoring

lc_a0      0.01
lc_gamma   3.0
lc_q0      0.19635
lc_kappa0  0.000648456
lc_kappa1  0.000648456
lc_xi      0.7

lc_Gamma   0.5

lc_q_initialisation        nematic
lc_q_init_amplitude        0.333333333333333
lc_init_redshift           1.0
lc_init_nematic            1.0_1.0_1.0

lc_coll_anchoring          planar
lc_coll_anchoring_w1       0.1
lc_coll_anchoring_w2       0.0

lc_wall_anchoring          normal
lc_wall_anchoring_w1       0.0

###############################################################################
#
#  Colloid parameters
#
###############################################################################

colloid_init          input_one

colloid_one_shape     sphere
colloid_one_a0        7.5
colloid_one_ah        7.5
colloid_one_euler     0.0_0.0_0.0
colloid_one_r         16.0_16.0_8.65

colloid_one_v         0.0_0.0_-0.2
colloid_one_isfixedv  1
colloid_one_rng       13

###############################################################################
#
#  Periodic conditions / boundaries
#
###############################################################################

periodicity     1_1_0
boundary_walls  0_0_1


###############################################################################
#
#  Output frequency and type
#
###############################################################################

freq_statistics  1
config_at_end    no

###############################################################################
#
#  Miscellaneous
#
###############################################################################

random_seed 8361235
